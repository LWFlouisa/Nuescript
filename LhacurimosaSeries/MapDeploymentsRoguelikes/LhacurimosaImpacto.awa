(hlim 2 :rat a_common_rat :araignee a_common_spider :gobelin a_common_gobelin)

(espace)

(encrireln UNDEAD RELATED)
(hlim 2 :squelette le_squelette :limon le_limon :donjon_unique one_way_Dungeon)

(espace)

(encrireln LOVECRAFTIAN CREATURES)
(hlim 2 :acideserupenete acid_serpent :acideduragone acid_dragon :noneseturasona treasonous_nun)

(espace)

(encrireln BOSSES)
(hlim 2 :sepeceterekimige sceptre_king :habucorosa female_elder_god :sepecetere_imeperaterica sceptre_king)

(espace)

(encrireln Lovecraftian Entities)
(hlim 2 :sea_gargoyal sea_gargoyal :acid_dragon acid_dragon :acid_serpent acid_serpent)
(hlim 2 :traitorous_nun traitorous_nun :cthulhu elder_god :ambiguous uncertain_monster)

