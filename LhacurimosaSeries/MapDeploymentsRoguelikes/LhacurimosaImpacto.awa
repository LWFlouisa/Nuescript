# #################################################################################### #
#                             Lhacurimosa Prediction Algorithm                         #
# #################################################################################### #
# This is the Lhacurimosa prediction algorithm that represents a valid use case for    #
# intended gameplay features. I wrote this because people kept taking elements out of  #
# context and using it in their on fanon content on youtube, or twisting it for        #
# purposes I do not condone or support. All requests for extra features for warlike    #
# purposes will be refused, and unauthorized changes reverted.                         #
# #################################################################################### #

# #################################################################################### #
#                                   Lunar Phase Impacts                                #
# #################################################################################### #
(encrireln Lunair De Grande)
(hlim 2 :new_moon new_moon :waxing_crescent waxing_crescent :first_quarter first_quarter)
(hlim 2 :waxing_gibbous waxing_gibbous :full_moon full_moon :waning_gibbous  waning_gibbous)
(hlim 2 :last_quarter last_quarter :waning_crescent waning_crescent :ambiguous uncertain_phase)

(espace)

(encrireln Lunair De Oublie)
(hlim 2 :new_moon new_moon :waxing_crescent waxing_crescent :first_quarter first_quarter)
(hlim 2 :waxing_gibbous waxing_gibbous :full_moon full_moon :waning_gibbous  waning_gibbous)
(hlim 2 :last_quarter last_quarter :waning_crescent waning_crescent :ambiguous uncertain_phase)

(espace)

(encrireln Lunair De Impact)
(hlim 2 :new_moon new_moon :waxing_crescent waxing_crescent :first_quarter first_quarter)
(hlim 2 :waxing_gibbous waxing_gibbous :full_moon full_moon :waning_gibbous  waning_gibbous)
(hlim 2 :last_quarter last_quarter :waning_crescent waning_crescent :ambiguous uncertain_phase)

(espace)

# #################################################################################### #
#                                     Bequest Dieties                                  #
# #################################################################################### #
# This brings back the diety mechanics of Bequest De Cendres which later morphed into  #
# Lhacurimosa. Lhacurimosa is the feminine declined version of the nueter term         #
# Lhacurimose. The dieties in this segment represents different forms of supernatural  #
# torment the MC goes through.                                                         #
# #################################################################################### #
(espace)

(encrireln dakupreiste / the dark priest
(hlim 2 :favor you_are_favored_by_the_diety :disfavor you_are_disfavored_by_the_diety :nuetral the_diety_is_indifferent_to_you

(espace)

(encrireln mort_naussance / diety of stillbirth
(hlim 2 :favor you_are_favored_by_the_diety :disfavor you_are_disfavored_by_the_diety :nuetral the_diety_is_indifferent_to_you

(espace)

(encrireln bourreau_de_karma / execution of karma
(hlim 2 :favor you_are_favored_by_the_diety :disfavor you_are_disfavored_by_the_diety :nuetral the_diety_is_indifferent_to_you

(espace)

(encrireln horyo_de_noir / thief in black
(hlim 2 :favor you_are_favored_by_the_diety :disfavor you_are_disfavored_by_the_diety :nuetral the_diety_is_indifferent_to_you

